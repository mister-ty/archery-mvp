# PostgreSQL connection string
# Local dev example: postgresql://postgres:postgres@localhost:5432/archery_mvp
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/archery_mvp?schema=public"

# Auth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-strong-random-secret"
AUTH_URL="http://localhost:3000"

# Seed admin credentials (used only by prisma/seed.ts on first run)
SEED_ADMIN_EMAIL="admin@archery.local"
SEED_ADMIN_PASSWORD="ChangeMe!ASAP123"
SEED_CLUB_NAME="Club Demo"

# Email — optional. If RESEND_API_KEY is unset, invitations are logged
# to the server console instead of being sent. Create a free account at
# https://resend.com to get an API key.
# RESEND_API_KEY=""
# RESEND_FROM_EMAIL="noreply@yourdomain.com"

# E2E only — set to "1" in the dev server used by Playwright tests so
# the login rate limiter doesn't block the test suite. NEVER enable in
# production.
# DISABLE_RATE_LIMIT="1"
